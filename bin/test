#!/bin/bash

NO_CONFINEMENT=false
REMAINING_ARGS=()
# When invoked directly (bypassing the snap launcher), SNAP is not set.
# Derive it from this script's own location: bin/test lives at $SNAP/bin/test.
SNAP="${SNAP:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"

for arg in "$@"; do
    case "$arg" in
        --no-confinement)
            NO_CONFINEMENT=true
            ;;
        *)
            REMAINING_ARGS+=("$arg")
            ;;
    esac
done

BIN_DIR="${SNAP}/usr/bin"

if [ "${#REMAINING_ARGS[@]}" -lt 1 ]; then
    echo "Usage: level-zero-tests.test [--no-confinement] <binary-name> [args...]" >&2
    echo "" >&2
    echo "  --no-confinement  Skip snap-bundled Level Zero drivers and use host" >&2
    echo "                    drivers exclusively. Intended for use with the" >&2
    echo "                    Checkbox framework when snap sandboxing is removed." >&2
    exit 2
fi

binname="${REMAINING_ARGS[0]}"

case "${binname}" in
    test_*) ;;
    *)
        echo "Test not found: ${binname}" >&2
        echo "Run: level-zero-tests.list-tests" >&2
        exit 2
        ;;
esac

if [ ! -x "${BIN_DIR}/${binname}" ]; then
    echo "Test not found: ${binname}" >&2
    echo "Run: level-zero-tests.list-tests" >&2
    exit 2
fi

ARCH="${SNAP_ARCH:-$(dpkg --print-architecture)}"
case "$ARCH" in
    amd64) ARCH_TRIPLE=x86_64-linux-gnu ;;
    arm64) ARCH_TRIPLE=aarch64-linux-gnu ;;
    *)     ARCH_TRIPLE="${ARCH}-linux-gnu" ;;
esac

if [ "$NO_CONFINEMENT" = "true" ]; then
    # Use host drivers exclusively. DT_RPATH (baked in by patchelf) beats
    # LD_LIBRARY_PATH, so preload every host ZE library the loader may
    # dlopen to avoid mixing a host loader with snap-bundled ICD/layer libs.
    HOST_LIB_DIR="/usr/lib/${ARCH_TRIPLE}"
    HOST_ZE="${HOST_LIB_DIR}/libze_loader.so.1"
    if [ ! -f "$HOST_ZE" ]; then
        echo "Error: --no-confinement requires the host Level Zero loader at $HOST_ZE"
        echo "Install libze1 (or equivalent) on the host before using this mode."
        exit 1
    fi

    HOST_PRELOAD="${HOST_ZE}"
    for lib in libze_tracing_layer.so.1 libze_validation_layer.so.1 \
        libze_intel_gpu.so.1; do
        candidate="${HOST_LIB_DIR}/${lib}"
        if [ -f "$candidate" ]; then
            HOST_PRELOAD="${HOST_PRELOAD}:${candidate}"
        fi
    done

    export LD_PRELOAD="${HOST_PRELOAD}"
    export LD_LIBRARY_PATH="${HOST_LIB_DIR}:/usr/lib"
    # Without this, tracing/validation callbacks are never wired in and
    # dynamic-tracing tests silently see zero invocations (or hang waiting
    # on callbacks that never fire).
    export ZE_ENABLE_TRACING_LAYER=1
    echo "Host Level Zero libraries: ${HOST_PRELOAD}"
fi

# Some tests write CWD-relative files (sockets, module caches), which fails
# with "Read-only file system" from BIN_DIR. Others spawn helpers or load
# assets (e.g. .spv kernels) via CWD-relative paths. Run from a writable
# dir, symlinked to BIN_DIR's contents, so both cases work.
WORK_DIR="${SNAP_USER_COMMON:-${SNAP_USER_DATA:-${TMPDIR:-/tmp}/level-zero-tests-$(id -u)}}/testrun"
mkdir -p "${WORK_DIR}"
for entry in "${BIN_DIR}"/*; do
    name="$(basename "${entry}")"
    if [ ! -e "${WORK_DIR}/${name}" ]; then
        ln -sfn "${entry}" "${WORK_DIR}/${name}"
    fi
done

cd "${WORK_DIR}"
exec "${BIN_DIR}/${binname}" "${REMAINING_ARGS[@]:1}"
